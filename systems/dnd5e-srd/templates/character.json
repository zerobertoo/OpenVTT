        {
          "id": "level",
          "type": "number",
          "label": "level",
          "default": 1,
          "min": 1,
          "max": 20
        },
        {
          "id": "proficiency",
          "type": "computed",
          "label": "proficiency",
          "formula": "floor((@level - 1) / 4) + 2"
        }
