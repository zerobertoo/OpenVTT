{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": [
      "packages/*/src/**",
      "packages/*/.storybook/**",
      "e2e/**",
      "playwright.config.ts",
      "scripts/**",
      "*.json",
      "!**/pnpm-lock.yaml",
      "!**/dist",
      "!**/node_modules",
      "!**/storybook-static",
      "!**/*.css"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 140 },
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always", "trailingCommas": "all" } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": { "preset": "recommended", "useButtonType": "warn", "useSemanticElements": "warn" },
      "correctness": { "useExhaustiveDependencies": "warn" },
      "suspicious": {
        "noArrayIndexKey": "warn",
        "noAssignInExpressions": "warn",
        "noImplicitAnyLet": "warn",
        "useIterableCallbackReturn": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/test-utils.ts", "e2e/**"],
      "linter": { "rules": { "style": { "noNonNullAssertion": "off" } } }
    }
  ],
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
