{
  "name": "openvtt",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @openvtt/server --filter @openvtt/client dev",
    "build": "pnpm --filter @openvtt/client build",
    "start": "pnpm --filter @openvtt/client build && pnpm --filter @openvtt/server start",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "catalog": "pnpm --filter @openvtt/client catalog",
    "test:e2e": "pnpm build && playwright test",
    "check:i18n": "node scripts/check-i18n.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.3",
    "@playwright/test": "^1.64.1",
    "typescript": "^5.7.0"
  }
}
